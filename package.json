{
  "name": "sql-query-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript SQL query optimizer agent (LangChain, model-provider agnostic)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend -w packages/frontend",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "backend:dev": "npm run dev -w packages/backend",
    "frontend:dev": "npm run dev -w packages/frontend",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
