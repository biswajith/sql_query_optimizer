# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Model, as "provider:model". LangChain resolves the provider, so switching
# is a config change plus installing that provider's @langchain/* package.
LLM_MODEL=openai:gpt-6-luna
OPENAI_API_KEY=
# Optional. Leave unset unless the model accepts a temperature.
# LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=120000

# MySQL. Use the read-only user created by init.sql.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=optimizer_ro
MYSQL_PASSWORD=optimizer_ro_pass
MYSQL_DATABASE=testdb
MYSQL_STATEMENT_TIMEOUT_MS=10000

# Redis (schema and index cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
